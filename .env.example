# Telegram Bot Token (получите у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# URL страницы входа для WebApp (должен быть доступен пользователю по HTTPS для работы в Telegram WebApp)
# Например: https://your-domain.com/login или http://localhost:8080/login
WEBAPP_URL=http://localhost:8080/login

# Настройки встроенного веб-сервера для страницы входа и статических файлов
ENABLE_WEBAPP_SERVER=true
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Путь к файлу базы данных SQLite
DATABASE_PATH=data/dnevnik.db

# Секретный ключ для шифрования токенов в базе данных (Fernet base64 32-байта)
# Сгенерировать можно командой: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если оставить пустым, ключ сгенерируется автоматически при первом запуске и сохранится в data/.secret_key
SECRET_KEY=

# Интервалы обновления токенов
# Проверять токены каждые N секунд (по умолчанию: 60)
REFRESH_INTERVAL_SEC=60
# Обновлять токен, если до его истечения осталось менее N секунд (по умолчанию: 600 = 10 мин)
REFRESH_BEFORE_SEC=600

# Базовый URL API дневника (Свердловская область)
DNEVNIK_API_URL=https://dnevnik.egov66.ru/api

# Учебный год по умолчанию (если пусто, выбирается автоматически из API Дневника)
SCHOOL_YEAR=

# Тестовая дата недели для расписания (используется автоматически, если на текущей неделе 0 уроков, например на каникулах)
TEST_SCHEDULE_DATE=2025-05-12
